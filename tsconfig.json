{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./door-os-frontend/*"]
    }
  },
  "include": [
    "door-os-frontend/**/*",
    "door-os-backend/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/.next",
    "**/dist"
  ]
}

